# ESP-IDF sdkconfig defaults for Google Maps on ST7789 project
# WiFi
CONFIG_ESP_WIFI_SSID=""
CONFIG_ESP_WIFI_PASSWORD=""
CONFIG_ESP_MAXIMUM_RETRY=10

# mbedTLS – use certificate bundle for HTTPS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# HTTP client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# SPI
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# Main task stack (need enough for WiFi + HTTP + JPEG + BLE svc registration)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Enable large HTTP downloads
CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=n

# BLE (NimBLE peripheral — receives map packets from the phone)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# Central must stay enabled in IDF 4.4: NimBLE's ble_gap.c references
# ble_gap_master_set_timer() (a central-only symbol) even when peripheral-only.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_SM_ENABLE=n

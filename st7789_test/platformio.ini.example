; PlatformIO config for ST7789 display test (Arduino framework)
; Copy this to platformio.ini in your test project folder

[env:esp32-c3-devkitm-1]
platform = espressif32
board = esp32-c3-devkitm-1
framework = arduino

monitor_speed = 115200
monitor_filters = direct

upload_protocol = esptool
upload_port = /dev/cu.usbmodem3101
monitor_port = /dev/cu.usbmodem3101

board_build.flash_mode = dio
board_build.f_flash = 40000000L

; Required libraries (PlatformIO will download automatically)
lib_deps =
    adafruit/Adafruit GFX Library @ ^1.11.9
    adafruit/Adafruit ST7735 and ST7789 Library @ ^1.10.4

; Enable USB CDC for Serial output on ESP32-C3
build_flags =
    -DARDUINO_USB_CDC_ON_BOOT=1
